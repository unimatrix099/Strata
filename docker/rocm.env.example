# Strata (ROCm) - docker/install.sh writes this as .env with the values it detects (GPUs, groups, RAM); or copy it to
# .env next to docker-compose.rocm.yml and edit by hand. docs/DOCKER_ROCM.md explains each value.
# Changing a value: docker compose -f docker-compose.rocm.yml up -d (recreates the container; no reinstall), except
# MODEL / CONTEXT / KV / GPUS on a model already set up, which need REINSTALL=1 once.

# ---- the host (required) ----
# numeric IDs of the host's video and render groups: getent group video render
VIDEO_GID=44
RENDER_GID=992
# the host folder with Strata's data (models, packs, the MTP layer, the configs); an existing Strata-data folder is
# reused - nothing is downloaded again
STRATA_DATA_DIR=./strata-data

# ---- the network ----
# where the port is published on the host: 127.0.0.1 (this PC only) or 0.0.0.0 (the network: set API_KEY!)
BIND=127.0.0.1
PORT=8080
API_KEY=

# ---- the model (used on the first start, or with REINSTALL=1) ----
# FAMILY: qwen = the original Qwen3.8-Flash-Next, swift = Swift 1.5 (thinks shorter; the production choice since 11 Oct:
# 78 of 79 known-answer items against the original IQ3_XXS's 75 on 2x RX 7900 XTX), coder = the coding version (IQ1_M)
# MODEL: IQ3_S (~84 GB download, 96 GB+ RAM), IQ3_XXS (~76 GB, 64 GB+), IQ2_XS (~68 GB, 48 GB+), Q2_0 (qwen only)
FAMILY=swift
MODEL=IQ3_S
# the model's maximum is 262144 (checked on 2x RX 7900 XTX: needles, facts and a long answer up to 240K)
CONTEXT=262144
KV=int8
# both cards, the one without the desktop first (HIP numbering; see docs/AMD_HIP.md); one card: GPU=0 instead
GPUS=1,0
# REINSTALL=1

# ---- the build ----
# the cards' architecture: gfx1100 = RX 7900 XT/XTX/GRE
HIP_ARCHS=gfx1100
# the base image: ubuntu:24.04 = setup.py's pinned ROCm (recommended); or an AMD image (docs/DOCKER_ROCM.md): on this PC
# rocm/dev-ubuntu-24.04:7.14.1-full was stable but read prompts ~40% slower, 10.1.0-full gave GPU memory faults
ROCM_IMAGE=ubuntu:24.04

# ---- the tuned settings for 2x RX 7900 XTX (FORK.md); empty = setup's choice ----
PIPELINE_WINDOWS=2
SPEC=3
SPEC_MIN_P=0.7
DRAFT_VOCAB=en
VRAM_RESERVE_MIB=700
VRAM_RESERVE_LATER_MIB=3072
KV_RESIDENT=32768
CONVERSATION_CACHE_MIB=16384
CONVERSATION_CACHE_SLOTS=4
# several conversations at once: 8 for short-context agents (180 tok/s in all); 1 for long contexts
PARALLEL=
# the engine's switches
STRATA_PIPELINE_DEBUG=1
STRATA_PIPELINE_THETA=0.1
STRATA_QFUSE=1
# upstream's fused prompt path: prompts 1.8-2.3x faster here; its answers can differ in wording from the default path's
STRATA_PF_FUSED=1
# the prompt attention on the matrix cores (+20% on prompts here; not bit-identical with the default)
STRATA_HIP_WMMA=1
# the CPU computes a short chunk's non-resident experts (1K-token reads +13-16% here), on chunks below 2048 tokens
# (longer chunks stream: 4K prompts +1.5% against the limit 3072)
STRATA_PREFILL_CPU_SHARE=1
STRATA_PREFILL_CPU_SHARE_MAX=2048
# the prompt attention with single FP16 q and p (+2-3.5% on long prompts here)
STRATA_PA_FAST=1
# decode: each layer's FFN half as 11 GPU kernels instead of 23 (HIP only, bit-exact; +3.5% and +2.7% decode here)
STRATA_HIP_POST_SPLIT=1
STRATA_HIP_FRONT_FUSE=1
# more engine flags, as on a command line; --ple-io ram = the 28.8 GB per-layer embedding table in RAM (needs the RAM and
# the memlock limit the compose file sets; 4K prompts +22-29% here)
EXTRA_ARGS=--ple-io ram --remote-expert-opt
