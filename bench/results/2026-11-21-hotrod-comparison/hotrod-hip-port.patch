+        values[i] = __builtin_nontemporal_load(logits + lane + i * 32);   // HIP port: no __ldcg; a load that bypasses the CU's cache
+#else
+        values[i] = __ldcg(logits + lane + i * 32);
+#endif
     __syncwarp();
     float maximum = -INFINITY;
 #pragma unroll
@@ -1883,7 +1888,11 @@ __device__ __forceinline__ float la_block_sum(float v, float* sh) {
 }
 __device__ __forceinline__ unsigned long long la_now() {   // the GPU's clock (ns), for the timing only
     unsigned long long now;
+#if defined(__HIP_PLATFORM_AMD__)
+    now = (unsigned long long) wall_clock64() * 10ull;   // HIP port: 100 MHz constant clock -> ns
+#else
     asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(now));
+#endif
     return now;
 }
 
